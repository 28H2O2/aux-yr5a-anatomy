 ["shot","qa/urinal-moving.png",".u-layout"],
 ["eval","(()=>{const space=document.createElement('div');space.style.height='1400px';document.body.append(space);scrollTo(0,document.body.scrollHeight-innerHeight);})()"],
 ["wait",500],
 ["eval","window.qaDots=[...document.querySelectorAll('[data-flow-dot=\"outlet.pipe\"]')].map(n=>[n.getAttribute('cx'),n.getAttribute('cy')]);"],
