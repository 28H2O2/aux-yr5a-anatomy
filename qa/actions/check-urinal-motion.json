 ["eval","(()=>{const next=[...document.querySelectorAll('[data-flow-dot=\"outlet.pipe\"]')].map(n=>[n.getAttribute('cx'),n.getAttribute('cy')]);if(JSON.stringify(next)===JSON.stringify(window.qaDots))throw Error('Flow did not animate');for(const dot of document.querySelectorAll('[data-flow-dot]'))if(dot.parentElement.dataset.flowRoute!==dot.dataset.flowDot)throw Error('Particle in wrong route');return {flowAnimated:true};})()"],
